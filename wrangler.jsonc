{
  // 账号：Zhengfande666@gmail.com's Account
  "account_id": "72b15fa81a48da4b92492a19ead56cf0",
  "name": "fe-boldsaasify-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // 纯 SSG：已移除 ISR 的 R2 增量缓存 / D1 tag 缓存 / DO 刷新队列绑定。
  // 删除 DO class 必须走迁移声明 deleted_classes，否则部署报错。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] },
    { "tag": "v2", "deleted_classes": ["DOQueueHandler"] }
  ],

  // 实时取价路由(/api/cart、/api/products-offer、/api/products-catalog)仍需 worker 运行。
  "services": [{
    "binding": "WORKER_SELF_REFERENCE",
    "service": "fe-boldsaasify-store"
  }]
}
